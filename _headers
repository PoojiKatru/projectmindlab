# Cloudflare Pages headers.
#
# Deliberately NO Content-Security-Policy yet. Worth adding now that the Pyodide
# data lab is gone — the site's only scripts are same-origin plus Google Fonts —
# but it should be added and then actually loaded in a browser to confirm the
# Trust Table iframe and its scripts still run.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# The Trust Table is embedded in an iframe on /#/data. X-Frame-Options: DENY
# above blocks framing even from the same origin, so this page needs SAMEORIGIN
# or the frame renders blank.
/game/*
  X-Frame-Options: SAMEORIGIN
