# Cloudflare Pages headers.
#
# Deliberately NO Content-Security-Policy yet. Worth adding now that the Pyodide
# data lab is gone — the site's only scripts are same-origin plus Google Fonts —
# but it should be added and then actually loaded in a browser to confirm the
# Trust Table iframe and its scripts still run.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # SAMEORIGIN, not DENY: /#/data frames game/ from this same origin.
  # Cross-origin framing is still blocked, which is the clickjacking risk.
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

